<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TomatoPotato.Views.DetailWindow"
        Title="Detail filmu" Width="400" Height="450"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="10">

    <TextBlock Name="TxtNazev" FontSize="22" FontWeight="Bold" />
    <TextBlock Name="TxtZanr" />
    <TextBlock Name="TxtRok" />
    <TextBlock Name="TxtDelka" />
    <TextBlock Name="TxtHodnoceni" FontSize="18" Foreground="OrangeRed" />
    <TextBlock Name="TxtZhledno" />
    <TextBlock Text="Popis:" FontWeight="Bold" Margin="0,10,0,0" />
    <TextBlock Name="TxtPopis" TextWrapping="Wrap" />

    <Button Name="BtnZavrit" Content="Zavřít" HorizontalAlignment="Right" Margin="0,20,0,0" />

  </StackPanel>
</Window>
