<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TomatoPotato.Views.MessageBoxWindow"
        Title="Potvrzení" Width="300" Height="150"
        WindowStartupLocation="CenterOwner" CanResize="False">

  <StackPanel Margin="20" Spacing="15">
    <TextBlock Name="TxtZprava" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Name="BtnAno" Content="Ano" />
      <Button Name="BtnNe" Content="Ne" />
    </StackPanel>
  </StackPanel>
</Window>
