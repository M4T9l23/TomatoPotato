<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaLinuxTest.MainWindow"
        Title="My First Avalonia App"
        Width="1080" Height="960"
        Background="#150029">

    <Grid Margin="20">

        <!-- Main centered content -->
        <StackPanel Margin="20" Spacing="10">
            <Viewbox Stretch="Uniform" StretchDirection="Both"
                     MaxHeight="120" HorizontalAlignment="Center">
                <Border Padding="20,10" Background="#33FFFFFF" CornerRadius="10">
                    <TextBlock Text="TomatoPotato!"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#FFEDD6"/>
                </Border>
            </Viewbox>

            <TextBlock Text="This is a simple Avalonia window with a few buttons below."
                       TextWrapping="Wrap" HorizontalAlignment="Center"
                       Margin="0,0,0,10" Foreground="#FFEDD6"/>

            <Border HorizontalAlignment="Center"
                    CornerRadius="6" Padding="8,4"
                    Margin="0,10,0,0">
                <TextBlock x:Name="StatusText" Text=""
                           Foreground="#FFEDD6"/>
            </Border>
        </StackPanel>

        <!-- Top-right buttons -->
        <Border Background="#33FFFFFF" CornerRadius="10" Padding="15"
                HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Pridat"    Click="OnHelloClick"      Foreground="#FFEDD6"/>
                <Button Content="Prochazet" Click="OnChangeTextClick" Foreground="#FFEDD6"/>
            </StackPanel>
        </Border>

        <!-- LEFT-SIDE vertical list of boxes -->
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="50,200,0,0"
                    Width="280"
                    Spacing="20">

            <!-- Item 1 -->
            <StackPanel Spacing="4">
                <TextBlock Text="LOLLLL"
                           Foreground="#FFEDD6"
                           Margin="6,0,0,0"/>
                <Border Background="#33FFFFFF"
                        
                        CornerRadius="10"
                        Padding="12"
                        MinHeight="80"
                        Margin="20,0,0,0">
                    <TextBlock Text="Content goes here…"
                               Foreground="#FFEDD6"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Item 2 -->
            <StackPanel Spacing="4">
                <TextBlock Text="Text"
                           Foreground="#FFEDD6"
                           Margin="6,0,0,0"/>
                <Border Background="#33FFFFFF"
                        CornerRadius="10"
                        Padding="12"
                        MinHeight="80"
                        Margin="20,0,0,0">
                    <TextBlock Text="Content goes here…"
                               Foreground="#FFEDD6"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- add more items the same way -->

        </StackPanel>

    </Grid>
</Window>