<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:TomatoPotato.Models"
        x:Class="AvaloniaLinuxTest.MainWindow"
        Title="TomatoPotato"
        Width="1080" Height="960"
        Background="#150029">

    <Grid Margin="20">

        <!-- Main centered content -->
        <StackPanel Margin="0,0,0,0" Spacing="1" VerticalAlignment="Top">
            <Border Background="#33fff" CornerRadius="20" Padding="15" Margin="0,0,0,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: title -->
                    <Border Grid.Column="0"
                            Padding="20,10"
                            Background="#33FFF"
                            CornerRadius="20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock Text="TomatoPotato!"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#FFEDD6"/>
                    </Border>

                    <!-- Right: buttons -->
                    <Border Grid.Column="1"
                            Background="#33FFF"
                            CornerRadius="20"
                            Padding="15"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnPridat" Content="Pridat" Foreground="#FFEDD6"/>
                            <Button x:Name="BtnExport" Content="Export" Foreground="#FFEDD6"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Top-right buttons -->


        <!-- LEFT-SIDE list of films -->
        <ListBox x:Name="ListFilmy"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="50,300,0,40"
                 Width="320"
                 Background="Transparent"
                 BorderThickness="0">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Film">
                    <StackPanel Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Nazev}"
                                   Foreground="#FFEDD6"
                                   FontWeight="Bold"
                                   Margin="6,0,0,0"/>
                        <Border Background="#33FFF"
                                CornerRadius="20"
                                Padding="12"
                                MinHeight="60"
                                Margin="20,0,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Zanr}"
                                           Foreground="#FFEDD6"/>
                                <TextBlock Text="{Binding Popis}"
                                           Foreground="#FFEDD6"
                                           TextWrapping="Wrap"/>
                                <TextBlock Foreground="#FFEDD6">
                                    <Run Text="Rok: "/><Run Text="{Binding Rok}"/>
                                    <Run Text=" · Délka: "/><Run Text="{Binding Delka}"/>
                                    <Run Text=" min · ★ "/><Run Text="{Binding Hodnoceni}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>
        </ListBox>

    </Grid>
</Window>