<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TomatoPotato.Models"
        x:Class="AvaloniaLinuxTest.MainWindow"
        Title="TomatoPotato 🍅" Width="800" Height="600">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="10">
      <Button Name="BtnPridat" Content="+ Přidat film" />
      <Button Name="BtnExport" Content="📄 Export do TXT" />
    </StackPanel>

    <ListBox Name="ListFilmy" Margin="10">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="models:Film">
          <Grid ColumnDefinitions="*,100,80,80" Margin="5">
            <TextBlock Grid.Column="0" Text="{Binding Nazev}" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="{Binding Zanr}" />
            <TextBlock Grid.Column="2" Text="{Binding Hodnoceni, StringFormat='{}{0}/10'}" />
            <TextBlock Grid.Column="3" Text="{Binding Zhledno}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
